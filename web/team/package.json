{
  "name": "nodo-team-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "vantage-client generate --from schema.json --out src/vantage.gen.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p playwright",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet -o storybook-static",
    "test:gallery": "vitest run --project gallery",
    "test:visual": "playwright test -c playwright/gallery.config.ts",
    "test:e2e": "playwright test -c playwright/e2e.config.ts"
  },
  "overrides": {
    "@joshwooding/vite-plugin-react-docgen-typescript": "0.9.1"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@floating-ui/dom": "1.8.0",
    "@internationalized/date": "3.12.4",
    "@react-aria/optimize-locales-plugin": "2.1.0",
    "@tiptap/extension-list": "3.35.0",
    "@tiptap/extension-table": "3.35.0",
    "@tiptap/extension-text-style": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "@tiptap/suggestion": "3.35.0",
    "@vantage-ui/client": "file:vendor/vantage-ui-client-0.5.2.tgz",
    "dompurify": "3.4.18",
    "lucide-react": "1.77.0",
    "react": "18.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-vitest": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/browser": "5.1.1",
    "@vitest/browser-playwright": "5.1.1",
    "jsdom": "26.1.0",
    "playwright": "1.64.1",
    "storybook": "10.6.8",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.1.1"
  }
}
